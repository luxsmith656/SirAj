rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    
    // Auth tokens do not contain custom claims. We lookup the user document.
    function getUserData() { 
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; 
    }
    
    // Check role from users collection
    function hasRole(role) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData().get('role', 'student') == role;
    }
    
    function isAdmin() { return hasRole('admin') || isBootstrapAdmin(); }
    function isInstructor() { return hasRole('instructor') || isAdmin(); }
    
    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'castanar656@gmail.com';
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Entity Validations ---
    function isValidUser(data) {
      return (data.keys().hasAll(['email', 'role']) || data.keys().hasAll(['email', 'role', 'fullName'])) && 
             data.email is string && 
             data.role in ['student', 'instructor', 'admin'];
    }

    // --- RULES ---

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming()) || isAdmin();
      allow update: if (isOwner(userId) && !incoming().diff(existing()).affectedKeys().hasAny(["role", "email"])) || isAdmin();
      allow delete: if isAdmin();
    }
    
    match /learnerProfiles/{userId} {
      allow read: if isOwner(userId) || isInstructor();
      allow write: if isOwner(userId) || isAdmin();
    }
    
    match /badges/{badgeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /quizAttempts/{attemptId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isInstructor());
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }
    
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isInstructor();
    }
    
    match /topics/{topicId} {
      allow read: if isSignedIn();
      allow write: if isInstructor();
    }
    
    match /modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if isInstructor();
    }
    
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isInstructor();
    }
    
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create: if isInstructor();
      allow update: if isInstructor() && (existing().instructorId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    
    match /classEnrollments/{enrollmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (incoming().studentId == request.auth.uid || isInstructor());
      allow update, delete: if isInstructor() || isOwner(existing().studentId);
    }
    
    match /diagnosticAttempts/{attemptId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isInstructor());
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid;
    }

    match /moduleProgress/{progressId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isInstructor());
      allow create, update: if isSignedIn() && (incoming().userId == request.auth.uid || (resource != null && existing().userId == request.auth.uid));
    }
    
    match /aiDrafts/{draftId} {
      allow read, write: if isInstructor();
    }
    
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /submissions/{submissionId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
    }
  }
}

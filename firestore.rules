rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    
    function getUserData() { 
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; 
    }
    
    function isAdmin() { 
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData().get('role', 'student') == 'admin'; 
    }
    
    function isInstructor() { 
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData().get('role', 'student') == 'instructor'; 
    }
    
    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'castanar656@gmail.com';
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) || isBootstrapAdmin() || isAdmin();
      allow update: if isOwner(userId) || isBootstrapAdmin() || isAdmin();
      allow delete: if isBootstrapAdmin() || isAdmin() || (isSignedIn() && request.auth.token.email == existing().email);
    }
    
    match /learnerProfiles/{userId} {
      allow read: if isOwner(userId) || isBootstrapAdmin() || isAdmin() || isInstructor();
      allow write: if isOwner(userId) || isBootstrapAdmin() || isAdmin();
    }
    
    match /quizAttempts/{attemptId} {
      allow read: if isSignedIn();
      allow write: if isOwner(incoming().userId) || isBootstrapAdmin() || isAdmin();
    }
    
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isBootstrapAdmin() || isAdmin() || isInstructor();
    }
    
    match /topics/{topicId} {
      allow read: if isSignedIn();
      allow write: if isBootstrapAdmin() || isAdmin() || isInstructor();
    }
    
    match /modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if isBootstrapAdmin() || isAdmin() || isInstructor();
    }
    
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isBootstrapAdmin() || isAdmin() || isInstructor();
    }
    
    match /classes/{classId} {
      // Anyone can read a class by its code or if they are enrolled, but we allow signed-in users to list/query to make it easier for now (or at least read by ID)
      allow read: if isSignedIn();
      allow create: if isInstructor() || isAdmin() || isBootstrapAdmin();
      allow update: if isBootstrapAdmin() || isAdmin() || (isInstructor() && existing().instructorId == request.auth.uid);
      allow delete: if isBootstrapAdmin() || isAdmin();
    }
    
    match /classEnrollments/{enrollmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (incoming().studentId == request.auth.uid || isInstructor() || isAdmin());
      allow update: if isBootstrapAdmin() || isAdmin() || (isInstructor() && existing().instructorId == request.auth.uid) || isOwner(existing().studentId);
      allow delete: if isBootstrapAdmin() || isAdmin() || (isInstructor() && existing().instructorId == request.auth.uid);
    }
    
    match /diagnosticAttempts/{attemptId} {
      allow create, update: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isInstructor() || isAdmin());
    }

    match /learnerProfiles/{profileId} {
      allow create, update: if isSignedIn() && request.auth.uid == profileId;
      allow read: if isSignedIn() && (profileId == request.auth.uid || isInstructor() || isAdmin());
    }

    match /quizAttempts/{attemptId} {
      allow create, update: if isSignedIn() && (incoming().userId == request.auth.uid || existing().userId == request.auth.uid);
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isInstructor() || isAdmin());
    }

    match /moduleProgress/{progressId} {
      allow create, update: if isSignedIn() && (incoming().userId == request.auth.uid || existing().userId == request.auth.uid);
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isInstructor() || isAdmin());
    }
    
    match /aiDrafts/{draftId} {
      allow read, write: if isSignedIn() && (isInstructor() || isAdmin() || isBootstrapAdmin());
    }
    
    match /settings/{docId} {
      allow read: if true;
      allow write: if isBootstrapAdmin() || isAdmin();
    }
    
    match /submissions/{submissionId} {
      allow create: if isSignedIn();
      // Relaxed read for development to avoid query/list permission errors with complex get() calls
      allow read: if isSignedIn();
    }
  }
}

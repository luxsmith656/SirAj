rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    
    function getUserData() { 
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; 
    }
    
    function isAdmin() { 
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData().get('role', 'student') == 'admin'; 
    }
    
    function isInstructor() { 
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData().get('role', 'student') == 'instructor'; 
    }
    
    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'castanar656@gmail.com';
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) || isBootstrapAdmin() || isAdmin();
      allow update: if isOwner(userId) || isBootstrapAdmin() || isAdmin();
      allow delete: if isBootstrapAdmin() || isAdmin() || (isSignedIn() && request.auth.token.email == existing().email);
    }
    
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isBootstrapAdmin() || isAdmin();
    }
    
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isBootstrapAdmin() || isAdmin();
    }
    
    match /settings/{docId} {
      allow read: if true;
      allow write: if isBootstrapAdmin() || isAdmin();
    }
    
    match /submissions/{submissionId} {
      allow create: if isSignedIn();
      // Relaxed read for development to avoid query/list permission errors with complex get() calls
      allow read: if isSignedIn();
    }
  }
}

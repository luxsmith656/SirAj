rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // Fallback for bootstrap admin
    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'castanar656@gmail.com';
    }

    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Collections ---

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin() || isBootstrapAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isBootstrapAdmin();
      
      function isValidCategory(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() <= 100;
      }

      allow create: if (isAdmin() || isBootstrapAdmin()) && isValidCategory(incoming());
      allow update: if (isAdmin() || isBootstrapAdmin()) && isValidCategory(incoming());
      allow delete: if isAdmin() || isBootstrapAdmin();
    }

    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isBootstrapAdmin();

      function isValidQuestion(data) {
        return data.stem is string && data.stem.size() > 0
          && data.options is list && data.options.size() >= 2
          && data.categoryId is string;
      }

      allow create: if (isAdmin() || isBootstrapAdmin()) && isValidQuestion(incoming());
      allow update: if (isAdmin() || isBootstrapAdmin()) && isValidQuestion(incoming());
      allow delete: if isAdmin() || isBootstrapAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      function isValidSubmission(data) {
        return data.userId == request.auth.uid
          && data.questionId is string
          && data.selectedOptionId is string
          && data.timestamp is string;
      }

      allow create: if isSignedIn() && isValidSubmission(incoming());
      // Submissions are immutable except for metadata if any
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
